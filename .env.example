# GIFTORY ENVIRONMENT CONFIGURATION
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# DATABASE (MONGODB)
MONGODB_URI=mongodb://127.0.0.1:27017/giftory

# JWT AUTHENTICATION
JWT_ACCESS_SECRET=giftory_jwt_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=giftory_jwt_refresh_secret_super_secure_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password-reset email adapter (HTTPS JSON endpoint; see backend/AUTH.md).
AUTH_EMAIL_URL=
AUTH_EMAIL_TOKEN=

# CLOUDINARY (MEDIA ASSETS)
CLOUDINARY_CLOUD_NAME=giftory_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz123

# BP05 / BP06: MongoDB must be a replica set (or Atlas) for atomic transactions.
# Example: mongodb://127.0.0.1:27017/giftory?replicaSet=rs0
# Optional review reward, only after moderation approves publication.
REVIEW_REWARD_POINTS=0
# HTTPS refund adapter endpoint and server-side credential. Leave blank until connected.
REFUND_GATEWAY_URL=
REFUND_GATEWAY_TOKEN=
# Your real customer-support Zalo URL, e.g. https://zalo.me/<business-id>
SUPPORT_ZALO_URL=
# Existing mock payment endpoint is disabled unless explicitly enabled for development.
ENABLE_PAYMENT_SIMULATION=false
